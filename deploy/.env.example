# Server-side settings for the demo, kept at /home/YZ/varfold/.env
# (scripts/setup-server.sh creates it from this file).
#
# Live folding stays OFF on the shared server: the site answers entirely from the
# precomputed bundle and never asks a GPU to fold anything. Sequences that are in
# the dataset are still answered instantly on the Live fold page.
VARFOLD_WORKER_URL=
VARFOLD_WORKER_TOKEN=
VARFOLD_LIVE_PER_HOUR=6
VARFOLD_LIVE_MAX_LENGTH=400
VARFOLD_WORKER_TIMEOUT=300
